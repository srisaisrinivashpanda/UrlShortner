# ==========================================
# Frontend Production Environment Variables
# ==========================================

# Public URL of the Spring Boot Backend API (no trailing slash)
VITE_BACKEND_URL=https://your-backend.onrender.com

# Public URL of this Frontend SPA (no trailing slash)
VITE_REACT_FRONT_END_URL=https://your-frontend.vercel.app

# Optional: Subdomain URL for direct short link handling
VITE_REACT_SUBDOMAIN=https://your-frontend.vercel.app
