# ==========================================
# Backend Production Environment Variables
# ==========================================

# Server Port (Render / Railway injects PORT automatically)
PORT=9090

# Database Configuration
# Local Docker: jdbc:postgresql://postgres-db:5432/urlshortenerdb
# Cloud (Render/Neon/Supabase): jdbc:postgresql://<host>:5432/<dbname>?sslmode=require
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/urlshortenerdb
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver
SPRING_JPA_HIBERNATE_DIALECT=org.hibernate.dialect.PostgreSQLDialect

# Connection Pooling
HIKARI_MAX_POOL_SIZE=10
HIKARI_MIN_IDLE=2

# Hibernate DDL Mode (update for dev/prototyping, validate for strict production)
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# Logging
SHOW_SQL=false

# JWT Configuration (Must be at least 256-bit / 32-byte secret key)
JWT_SECRET=9632e8e84e2e58714f873ed2189c287848f40d254230e50d8c94d1269db072ff2f007fe86e2e12b67fadaa0db0370346def1b18790ee0e8d1ca599534660e13b
JWT_EXPIRATION=172800000

# CORS: Allowed Frontend URL(s) - Comma-separated list for multiple domains
FRONTEND_URL=http://localhost:5173,https://your-frontend.vercel.app
